# Copy this file to .env and fill in your own values. Never commit .env.
PORTKEY_API_KEY=your-portkey-api-key-here
OPENAI_MODEL=gpt-6-luna
MANAGER_MODEL=gpt-6-sol

# Optional: model prices per million tokens, used for the $0.10-per-request limit
INPUT_PRICE_PER_MILLION=2.50
OUTPUT_PRICE_PER_MILLION=15.00
MANAGER_INPUT_PRICE_PER_MILLION=5.00
MANAGER_OUTPUT_PRICE_PER_MILLION=30.00
